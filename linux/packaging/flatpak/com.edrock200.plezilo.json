{
  "app-id": "com.edrock200.plezilo",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "plezilo",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--device=all",
    "--own-name=org.mpris.MediaPlayer2.com_edrock200_plezilo",
    "--system-talk-name=org.freedesktop.NetworkManager",
    "--filesystem=xdg-run/os_media_controls_artwork:create",
    "--filesystem=xdg-run/discord-ipc-0",
    "--filesystem=xdg-run/discord-ipc-1",
    "--filesystem=xdg-run/discord-ipc-2",
    "--filesystem=xdg-run/discord-ipc-3",
    "--filesystem=xdg-run/discord-ipc-4",
    "--filesystem=xdg-run/discord-ipc-5",
    "--filesystem=xdg-run/discord-ipc-6",
    "--filesystem=xdg-run/discord-ipc-7",
    "--filesystem=xdg-run/discord-ipc-8",
    "--filesystem=xdg-run/discord-ipc-9",
    "--filesystem=xdg-run/app/com.discordapp.Discord:ro",
    "--env=GTK_USE_PORTAL=1"
  ],
  "build-options": {
    "strip": false,
    "no-debuginfo": true
  },
  "modules": [
    {
      "name": "plezilo",
      "buildsystem": "simple",
      "build-commands": [
        "cp -a bundle /app/plezilo",
        "install -Dm755 plezilo /app/bin/plezilo",
        "install -Dm644 com.edrock200.plezilo.desktop /app/share/applications/com.edrock200.plezilo.desktop",
        "install -Dm644 com.edrock200.plezilo.metainfo.xml /app/share/metainfo/com.edrock200.plezilo.metainfo.xml",
        "install -Dm644 plezilo.png /app/share/icons/hicolor/512x512/apps/com.edrock200.plezilo.png",
        "chmod 755 /app/plezilo/plezilo.sh",
        "if test -f /app/plezilo/lib/crashpad_handler; then chmod 755 /app/plezilo/lib/crashpad_handler; fi",
        "python3 relocate-caches.py /app/plezilo"
      ],
      "sources": [
        { "type": "dir", "path": "bundle", "dest": "bundle" },
        { "type": "file", "path": "plezilo" },
        { "type": "file", "path": "relocate-caches.py" },
        { "type": "file", "path": "com.edrock200.plezilo.desktop" },
        { "type": "file", "path": "com.edrock200.plezilo.metainfo.xml" },
        { "type": "file", "path": "plezilo.png" }
      ]
    }
  ]
}
